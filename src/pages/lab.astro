---
/**
 * Lab: two interactive pieces, then the small tools.
 *
 *   1. Contribution calendar: the GitHub year as a grid of squares that ripple in when scrolled
 *      into view ([data-inview]); hovering a square shows its day and count. The same numbers are
 *      written out as totals and a monthly table.
 *   2. Txtudio's products: a switcher ([data-switch], src/motion/micro.ts) whose screens and
 *      captions slide in.
 */
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import LabTools from '~/components/LabTools.astro';
import contributions from '~/data/contributions.json';
import workeron from '~/assets/work/workeron.jpg';
import snaptiqz from '~/assets/work/snaptiqz.jpg';
import doyourdesign from '~/assets/work/doyourdesign.jpg';
import { page } from '~/lib/content';
import { IDS, breadcrumbNode, webPageNode } from '~/lib/schema';
import { SITE } from '~/site.config';

const lab = await page('lab');
const d = lab.data;
const pieces = d.pieces ?? [];
const piece = (id: string) => pieces.find((p) => p.id === id);
const calendarPiece = piece('contribution-calendar');
const productsPiece = piece('products');

/** Txtudio's four products, captioned from the Txtudio case study. */
const products = [
  { label: 'Workeron', image: workeron, caption: 'A business suite: HRM, CRM, project management, marketing and forms on one sign-in, for businesses from one office to many branches.' },
  { label: 'Snaptiqz', image: snaptiqz, caption: 'Ticketing, registration forms and QR check-in for event organisers.' },
  { label: 'DoYourDesign', image: doyourdesign, caption: 'Projects, site visits and GST invoicing for interior design studios.' },
  { label: 'Audit Management', image: null, caption: 'On-premise internal audit software for Indian banks, with a read-only core banking connector.' },
];

/* The contribution calendar: one array per week, days in order from `from` (Sunday to Saturday). */
interface Calendar {
  total?: number;
  from?: string | null;
  weeks?: number[][];
}
const calendar = contributions as Calendar;
const weeks = calendar.weeks ?? [];
const days = weeks.flat();
const DAY = 86_400_000;
const first = calendar.from ? new Date(`${calendar.from}T00:00:00Z`) : null;
const start = first && !Number.isNaN(first.valueOf()) && days.length > 0 ? first : null;
const dayLabel = (i: number) => (start ? new Date(start.valueOf() + i * DAY).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '');
const level = (n: number) => (n === 0 ? 0 : n < 3 ? 1 : n < 8 ? 2 : n < 20 ? 3 : 4);
const months: { key: string; label: string; count: number }[] = [];
const monthStarts: { week: number; label: string }[] = [];
let busiest: { date: string; count: number } | null = null;
if (start) {
  const t0 = start.valueOf();
  days.forEach((n, i) => {
    const date = new Date(t0 + i * DAY);
    const key = date.toISOString().slice(0, 7);
    let month = months.at(-1);
    if (!month || month.key !== key) {
      month = { key, label: date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }), count: 0 };
      months.push(month);
      // Label a month only where there is room: at least three columns after the previous label.
      const week = Math.floor(i / 7);
      if (!monthStarts.length || week - monthStarts[monthStarts.length - 1].week >= 3) monthStarts.push({ week, label: date.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }) });
    }
    month.count += n;
    if (!busiest || n > busiest.count) busiest = { date: date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }), count: n };
  });
}
const peakMonth = Math.max(1, ...months.map((m) => m.count));
const total = calendar.total ?? days.reduce((sum, n) => sum + n, 0);
const figure = (n: number) => n.toLocaleString('en-IN');
const top = busiest as { date: string; count: number } | null;

const url = `${SITE.url}/lab`;
const schema = [
  {
    ...webPageNode({ path: '/lab', name: d.title, description: d.description, type: 'CollectionPage' }),
    ...(d.updated && { dateModified: d.updated.toISOString().slice(0, 10) }),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: pieces.length,
      itemListElement: pieces.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': 'CreativeWork', '@id': `${url}#${p.id}`, url: `${url}#${p.id}`, name: p.title, description: p.summary, author: { '@id': IDS.person } },
      })),
    },
  },
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: d.h1, path: '/lab' },
  ]),
];
---

<Base title={d.title} description={d.description} schema={schema} page="lab">
  <PageHead h1={d.h1} lede={d.intro} />

  <nav class="container lab-index" aria-label="Lab pieces">
    {
      pieces.map((p, i) => (
        <a href={`#${p.id}`} class="lab-index__link">
          <span class="lab-index__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span data-roll>{p.title}</span>
        </a>
      ))
    }
    <a href="#small-tools" class="lab-index__link">
      <span class="lab-index__n" aria-hidden="true">{String(pieces.length + 1).padStart(2, '0')}</span>
      <span data-roll>{d.toolsHeading ?? 'Small tools'}</span>
    </a>
  </nav>

  {
    calendarPiece && (
      <section class="piece" id={calendarPiece.id} aria-labelledby={`${calendarPiece.id}-title`}>
        <div class="container">
          <div class="piece__head">
            <p class="label">Piece 01</p>
            <h2 id={`${calendarPiece.id}-title`} class="piece__title display">{calendarPiece.title}</h2>
            <p class="piece__summary">{calendarPiece.summary}</p>
            <p class="piece__how">{calendarPiece.interaction}</p>
          </div>

          <div class="cal" data-inview aria-hidden="true">
            <div class="cal__months" style={`--weeks:${weeks.length}`}>
              {monthStarts.map((m) => (
                <span style={`--w:${m.week}`}>{m.label}</span>
              ))}
            </div>
            <div class="cal__grid" style={`--weeks:${weeks.length}`}>
              {weeks.map((week, w) =>
                week.map((n, dIdx) => (
                  <span class="cal__day" data-level={level(n)} data-tip={`${figure(n)} on ${dayLabel(w * 7 + dIdx)}`} style={`--w:${w};--d:${dIdx}`} />
                )),
              )}
            </div>
            <div class="cal__legend">
              <span class="label">Less</span>
              {[0, 1, 2, 3, 4].map((l) => (
                <span class="cal__day cal__day--key" data-level={l} />
              ))}
              <span class="label">More</span>
            </div>
          </div>

          <div class="cal-facts">
            <p class="cal-facts__big">
              <span class="numeral" data-count={total}>
                {figure(total)}
              </span>
              <span class="label">contributions in twelve months</span>
            </p>
            {top && (
              <p class="cal-facts__big">
                <span class="numeral" data-count={top.count}>
                  {figure(top.count)}
                </span>
                <span class="label">on {top.date}, the busiest day</span>
              </p>
            )}
            <table class="months" data-inview>
              <caption class="visually-hidden">GitHub contributions per month</caption>
              <thead class="visually-hidden">
                <tr>
                  <th scope="col">Month</th>
                  <th scope="col">Contributions</th>
                </tr>
              </thead>
              <tbody>
                {months.map((m, i) => (
                  <tr style={`--v:${m.count / peakMonth};--i:${i}`}>
                    <th scope="row">{m.label}</th>
                    <td>
                      <span class="months__bar" aria-hidden="true" />
                      {figure(m.count)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }

  {
    productsPiece && (
      <section class="piece" id={productsPiece.id} aria-labelledby={`${productsPiece.id}-title`}>
        <div class="container products" data-switch>
          <div class="products__text">
            <p class="label">Piece 02</p>
            <h2 id={`${productsPiece.id}-title`} class="piece__title display">{productsPiece.title}</h2>
            <p class="piece__summary">{productsPiece.summary}</p>
            <p class="piece__how">{productsPiece.interaction}</p>
            <ol class="products__list" role="list">
              {products.map((p, i) => (
                <li>
                  <button type="button" class="products__tab" data-switch-to={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                    <span class="products__n" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="products__name">{p.label}</span>
                    <span class="products__arrow" aria-hidden="true" />
                  </button>
                </li>
              ))}
            </ol>
            <a href="/work/txtudio" class="link-draw products__more">
              Read the Txtudio case study
            </a>
          </div>
          <div class="products__stage">
            {products.map((p, i) => (
              <figure class="products__panel" data-switch-panel={i} data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
                <div class="products__screen">
                  {p.image ? (
                    <Image src={p.image} alt={`${p.label} website`} widths={[600, 1000]} sizes="(min-width: 56rem) 52vw, 92vw" loading="lazy" />
                  ) : (
                    <div class="products__type">
                      <span class="display">{p.label}</span>
                      <span class="label">On-premise, for Indian banks</span>
                    </div>
                  )}
                </div>
                <figcaption>
                  <strong>{p.label}.</strong> {p.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {d.tools && d.tools.length > 0 && <LabTools heading={d.toolsHeading ?? 'Small tools'} tools={d.tools} />}
</Base>

<style>
  .lab-index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-bottom: var(--space-8);
  }

  .lab-index__link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--step-1);
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .lab-index__n {
    font-size: var(--step--1);
    color: var(--fg-faint);
  }

  .lab-index__link:hover {
    color: var(--coral-ink);
  }

  .piece {
    padding-block: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .piece__head {
    max-width: 44rem;
  }

  .piece__title {
    margin-top: var(--space-2);
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    line-height: 0.95;
  }

  .piece__summary {
    margin-top: var(--space-5);
    font-size: var(--step-0);
    line-height: 1.55;
    max-width: 38rem;
  }

  .piece__how {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--fg-soft);
    max-width: 38rem;
  }

  /* ---------- Contribution calendar ---------- */
  .cal {
    --cell: clamp(7px, calc((100vw - 2 * var(--gutter) - var(--rail)) / 60), 15px);
    --gap: 3px;
    margin-top: var(--space-7);
    overflow-x: auto;
    padding: 2.5rem 0 var(--space-3);
  }

  .cal__months {
    position: relative;
    height: 1.4rem;
    width: calc(var(--weeks) * (var(--cell) + var(--gap)));
    font-size: var(--step--1);
    color: var(--fg-soft);
  }

  .cal__months span {
    position: absolute;
    left: calc(var(--w) * (var(--cell) + var(--gap)));
  }

  .cal__grid {
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    grid-auto-flow: column;
    grid-auto-columns: var(--cell);
    gap: var(--gap);
    width: max-content;
  }

  .cal__day {
    position: relative;
    display: block;
    width: var(--cell);
    height: var(--cell);
    border-radius: 2px;
    background: #dcdcdc;
    outline: 1px solid transparent;
    outline-offset: 1px;
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.5s,
      outline-color 0.2s;
  }

  .cal__day[data-level='1'] {
    background: #f6c4b8;
  }

  .cal__day[data-level='2'] {
    background: #f39684;
  }

  .cal__day[data-level='3'] {
    background: #f2685a;
  }

  .cal__day[data-level='4'] {
    background: var(--coral-ink);
  }

  /* A ripple from left to right as the calendar scrolls into view. */
  :global(html.js-motion) .cal:not([data-inview='in']) .cal__grid .cal__day {
    opacity: 0;
    transform: scale(0.2);
  }

  .cal[data-inview='in'] .cal__grid .cal__day {
    transition-delay: calc(var(--w) * 14ms + var(--d) * 20ms);
  }

  .cal[data-inview='in'] .cal__grid .cal__day:hover {
    transform: scale(1.5);
    outline-color: var(--fg);
    z-index: 2;
    transition-delay: 0s;
  }

  .cal__grid .cal__day:hover::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) scale(0.67);
    transform-origin: bottom center;
    padding: 0.35rem 0.6rem;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--bg);
    background: var(--fg);
    border-radius: 3px;
    pointer-events: none;
  }

  .cal__legend {
    display: flex;
    align-items: center;
    gap: var(--gap);
    margin-top: var(--space-3);
  }

  .cal__legend .label {
    margin-inline: var(--space-2);
  }

  .cal-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-6);
    margin-top: var(--space-7);
    align-items: start;
  }

  .cal-facts__big {
    display: grid;
    gap: var(--space-2);
  }

  .cal-facts__big .numeral {
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 0.9;
    color: var(--fg);
  }

  .months {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .months th,
  .months td {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .months th {
    width: 6rem;
    color: var(--fg-soft);
  }

  .months td {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .months__bar {
    display: block;
    height: 0.5rem;
    width: calc(var(--v) * 70%);
    min-width: 2px;
    background: var(--coral);
    transform-origin: left;
    transition:
      transform 0.9s var(--ease-out),
      background 0.3s;
    transition-delay: calc(var(--i) * 45ms);
  }

  :global(html.js-motion) .months:not([data-inview='in']) .months__bar {
    transform: scaleX(0);
  }

  .months tr:hover .months__bar {
    background: var(--fg);
  }

  /* ---------- Products ---------- */
  .products {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-7);
    align-items: center;
  }

  .products__list {
    list-style: none;
    margin: var(--space-6) 0 var(--space-5);
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .products__tab {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    width: 100%;
    min-height: 3.5rem;
    padding: var(--space-3) 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: none;
    font: inherit;
    text-align: left;
    color: var(--fg-faint);
    cursor: pointer;
    transition: color 0.3s;
  }

  .products__n {
    font-size: var(--step--1);
  }

  .products__name {
    flex: 1;
    font-size: var(--step-2);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    transition: transform 0.5s var(--ease-out);
  }

  .products__arrow {
    width: 0;
    height: 1px;
    align-self: center;
    background: currentColor;
    transition: width 0.5s var(--ease-out);
  }

  .products__tab:hover,
  .products__tab[aria-pressed='true'] {
    color: var(--fg);
  }

  .products__tab:hover .products__name {
    transform: translateX(0.4rem);
  }

  .products__tab[aria-pressed='true'] .products__arrow {
    width: 3rem;
    background: var(--coral);
  }

  .products__stage {
    position: relative;
    display: grid;
  }

  .products__panel {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    transform: translateY(2rem) rotate(1.5deg);
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
    transition:
      opacity 0.5s,
      transform 0.9s var(--ease-out),
      clip-path 0.9s var(--ease-out);
  }

  .products__panel[data-active] {
    opacity: 1;
    transform: none;
    clip-path: inset(0 0 0 0);
    pointer-events: auto;
  }

  .products__screen {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--fg);
    background: var(--bg-raised);
    box-shadow: 0 40px 70px -40px rgb(0 0 0 / 0.45);
  }

  .products__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transform: scale(1.06);
    transition: transform 1.4s var(--ease-out);
  }

  .products__panel[data-active] .products__screen :global(img) {
    transform: scale(1);
  }

  .products__type {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    background: var(--paper-white);
  }

  .products__type .display {
    font-size: clamp(2.2rem, 4.5vw, 4.2rem);
    color: var(--coral);
    line-height: 0.95;
  }

  .products__panel figcaption {
    margin-top: var(--space-4);
    max-width: 40rem;
  }

  .products__more {
    display: inline-block;
  }

  @media (max-width: 56rem) {
    .products,
    .cal-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
