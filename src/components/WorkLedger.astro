---
/**
 * The Work index register: every case study as a ledger row, companies first, each group in the
 * order set by its frontmatter. A row links to its case study; the small toggle beside it opens the
 * stack and the outcome. Without JavaScript the panels stay open and the toggles are hidden.
 *
 * Each row carries data-preview, the URL of its cover image: on desktop the cover follows the
 * cursor while the row is hovered (src/motion/micro.ts). Decoration only; the row is the link.
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { toLedgerRow } from '~/lib/content';
import Logo from '~/components/Logo.astro';

const covers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/work/*.jpg', { eager: true });
const previews = new Map<string, string>();
for (const [path, mod] of Object.entries(covers)) {
  const id = path.split('/').pop()!.replace('.jpg', '');
  previews.set(id, (await getImage({ src: mod.default, width: 640, format: 'webp' })).src);
}

interface Props {
  entries: CollectionEntry<'work'>[];
  level?: 'h2' | 'h3';
}

const { entries, level = 'h2' } = Astro.props;
const Heading = level;

const groups = (
  [
    { id: 'work-companies', heading: 'Companies', kind: 'company' },
    { id: 'work-projects', heading: 'Projects', kind: 'project' },
  ] as const
)
  .map((g) => ({ ...g, entries: entries.filter((e) => e.data.kind === g.kind).sort((a, b) => a.data.order - b.data.order) }))
  .filter((g) => g.entries.length > 0);
---

{
  groups.map((g) => (
    <section class="ledger" aria-labelledby={g.id} data-reveal>
      <div class="ledger__head">
        <Heading id={g.id}>{g.heading}</Heading>
      </div>
      <ol class="ledger__rows" role="list">
        {g.entries.map((entry) => {
          const row = toLedgerRow(entry);
          const panelId = `work-detail-${entry.id}`;
          const { stack, outcome } = entry.data;
          const hasDetail = stack.length > 0 || Boolean(outcome);
          return (
            <li class="ledger__row work-row">
              <a class="ledger__link work-row__link" href={row.href} data-preview={previews.get(entry.id)} data-cursor="Read">
                <span class="ledger__year">{row.year}</span>
                <span class="ledger__name">
                  {(entry.id === 'txtudio' || entry.id === 'lofritex') && <Logo company={entry.id} variant="mark" brand class="work-row__logo" />}
                  {row.name}
                </span>
                <span class="ledger__role">{row.role}</span>
                <span class="ledger__summary">{row.summary}</span>
              </a>
              {hasDetail && (
                <button type="button" class="work-row__toggle" aria-expanded="false" aria-controls={panelId} data-work-toggle>
                  <span class="visually-hidden">{`Details for ${row.name}`}</span>
                  <svg class="work-row__icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M2.5 8h11" />
                    <path class="work-row__icon-v" d="M8 2.5v11" />
                  </svg>
                </button>
              )}
              {hasDetail && (
                <div class="work-row__detail" id={panelId}>
                  <div class="work-row__clip">
                    <dl class="work-row__facts">
                      {stack.length > 0 && (
                        <div class="work-row__fact">
                          <dt>Stack</dt>
                          <dd>
                            <ul class="chips">
                              {stack.map((item) => (
                                <li>{item}</li>
                              ))}
                            </ul>
                          </dd>
                        </div>
                      )}
                      {outcome && (
                        <div class="work-row__fact">
                          <dt>Outcome</dt>
                          <dd>{outcome}</dd>
                        </div>
                      )}
                    </dl>
                    <p class="work-row__more">
                      <a href={row.href} aria-label={`Read the case study: ${row.name}`}>Read the case study</a>
                    </p>
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </section>
  ))
}

<script>
  /*
   * One delegated listener opens and closes every Work row panel. Bundled scripts run once per visit
   * under the ClientRouter, so the listener lives on document and keeps working after navigation.
   * CSS shows or hides each panel from its toggle's aria-expanded state.
   */
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('button[data-work-toggle]');
    if (!button) return;
    button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'));
  });
</script>

<style>
  /* The mark hangs in the gutter so company names line up with the project names below. */
  .ledger__name :global(.work-row__logo) {
    margin: -0.12em 0.4em 0 -1.4em;
    font-size: 0.9em;
    transition: transform 0.6s var(--ease-out);
  }

  .work-row__link:hover :global(.work-row__logo) {
    transform: rotate(-12deg) scale(1.15);
  }

  .work-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.75rem;
    column-gap: var(--space-4);
  }

  .work-row__link {
    grid-column: 1;
    grid-row: 1;
  }

  /* The toggle only exists for visitors with JavaScript; without it every panel is already open. */
  .work-row__toggle {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  :global(html.js) .work-row__toggle {
    display: grid;
  }

  .work-row__toggle:hover,
  .work-row__toggle[aria-expanded='true'] {
    border-color: var(--fg-soft);
    color: var(--fg);
  }

  .work-row__toggle:focus-visible {
    border-radius: 999px;
  }

  .work-row__icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* Plus when closed, minus when open: the vertical stroke turns flat. */
  .work-row__icon-v {
    transform-box: fill-box;
    transform-origin: center;
  }

  .work-row__toggle[aria-expanded='true'] .work-row__icon-v {
    transform: rotate(90deg);
  }

  :global(html.js-motion) .work-row__icon-v {
    transition: transform 0.35s var(--ease-out);
  }

  /* Panel: open by default (no JavaScript), collapsed while its toggle says aria-expanded="false". */
  .work-row__detail {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-rows: 1fr;
  }

  /* The inline padding keeps focus rings inside the clipping box. */
  .work-row__clip {
    min-height: 0;
    overflow: hidden;
    margin-inline: -0.375rem;
    padding-inline: 0.375rem;
  }

  :global(html.js) .work-row__toggle[aria-expanded='false'] + .work-row__detail {
    grid-template-rows: 0fr;
    visibility: hidden;
  }

  :global(html.js-motion) .work-row__detail {
    transition:
      grid-template-rows 0.45s var(--ease-out),
      visibility 0s linear 0s;
  }

  :global(html.js-motion) .work-row__toggle[aria-expanded='false'] + .work-row__detail {
    transition:
      grid-template-rows 0.45s var(--ease-out),
      visibility 0s linear 0.45s;
  }

  /* Facts sit on the same columns as the row above: labels under the name, values under role and summary. */
  .work-row__facts {
    display: grid;
    row-gap: var(--space-3);
    margin: 0;
  }

  .work-row__fact,
  .work-row__more {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 2fr);
    column-gap: var(--space-5);
    align-items: baseline;
    font-stretch: var(--wdth-ledger);
    font-variant-numeric: tabular-nums;
  }

  .work-row__fact dt {
    grid-column: 2;
    color: var(--fg-faint);
  }

  .work-row__fact dd {
    grid-column: 3 / -1;
    margin: 0;
    color: var(--fg-soft);
  }

  .work-row__more {
    margin: var(--space-2) 0 0;
    padding-bottom: var(--space-5);
  }

  .work-row__more a {
    grid-column: 3 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* 52rem is the breakpoint of .ledger__link in global.css; keep them equal so the facts stay on its columns. */
  @media (max-width: 52rem) {
    .work-row__toggle {
      align-self: start;
      margin-top: var(--space-3);
    }

    .work-row__fact,
    .work-row__more {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      row-gap: var(--space-1);
    }

    .work-row__fact dt,
    .work-row__fact dd,
    .work-row__more a {
      grid-column: 2;
    }
  }

  @media print {
    .work-row__toggle {
      display: none !important;
    }

    .work-row__detail {
      grid-template-rows: 1fr !important;
      visibility: visible !important;
      transition: none !important;
    }
  }
</style>
