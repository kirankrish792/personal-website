---
/**
 * The author note under each post: a small round portrait, one sentence from person.json
 * (job title and location) and a link to About.
 */
import { Image } from 'astro:assets';
import portrait from '~/assets/portrait/kiran.png';
import person from '~/data/person.json';

// "Founder and CEO" reads "a founder and CEO". A title that starts with an acronym ("CTO and
// founder") keeps its capitals and takes the article its letter name sounds like ("an MD").
const lead = person.jobTitle.split(' ')[0];
const acronym = lead.length > 1 && lead === lead.toUpperCase();
const role = acronym ? person.jobTitle : person.jobTitle.charAt(0).toLowerCase() + person.jobTitle.slice(1);
const article = (acronym ? /^[AEFHILMNORSX]/ : /^[aeiou]/i).test(role) ? 'an' : 'a';
const { locality, region, country } = person.location;
const sentence = ` is ${article} ${role} based in ${locality}, ${region}, ${country}.`;
---

<div class="author">
  <span class="author__photo">
    <Image src={portrait} alt={person.name} width={112} height={112} densities={[1, 2, 3]} fit="cover" position="top" />
  </span>
  <div class="author__text">
    <p><span class="author__name">{person.name}</span>{sentence}</p>
    <a class="author__link" href="/about">About Kiran</a>
  </div>
</div>

<style>
  .author {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    column-gap: var(--space-5);
    align-items: center;
  }

  /* The image is a top-aligned square; the zoom centres the face inside the circle. */
  .author__photo {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    overflow: hidden;
    /* Older WebKit only clips a transformed child to the rounded corners inside its own stacking context. */
    isolation: isolate;
    background: var(--bg-raised);
  }

  .author__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.48);
    transform-origin: 34% 4%;
  }

  .author__text p {
    color: var(--fg-soft);
  }

  .author__name {
    color: var(--fg);
    font-weight: 500;
  }

  .author__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
